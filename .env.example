# Copy to backend/.env and adjust as needed.

# API port
PORT=5000

# Base URL encoded into QR codes, e.g. http://192.168.1.20:5173 or https://demo.example.com
# Leave empty to auto-detect: the dashboard's own origin with localhost swapped for this machine's LAN IP.
PUBLIC_APP_URL=

# Comma-separated list of allowed origins, or * for any (fine for local demos)
CORS_ORIGIN=*

# Persist the mock DB to backend/data/db.json (set to false for a pure in-memory store)
PERSIST=true

# Default length of a lecture check-in window, in minutes
DEFAULT_SESSION_MINUTES=90

# Proxies trusted to report the real client IP (X-Forwarded-For). Used to rate-limit wrong
# check-in codes per device. Local dev: leave empty (= loopback). Hosted behind a load
# balancer (Render, Railway, Fly, Heroku): 1
TRUST_PROXY=

# Signs the rotating QR codes and check-in tickets. Leave empty locally (a random one is saved
# in data/db.json). When hosted, set a long random value, e.g. from: openssl rand -base64 32
CHECKIN_SECRET=
